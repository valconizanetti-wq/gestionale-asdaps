APP_NAME="Compagnia Arcieri Castel Viscardo A.S.D."
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gestionale.arciericastello.it
# Dal 19/10/2026 nell'account cPanel arcieric (docs/deploy.md §0).

APP_TIMEZONE=Europe/Rome
APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=arcieric_asd
DB_USERNAME=arcieric_asd
DB_PASSWORD="la-password-del-database"

# ↓ copia questi tre valori dal .env locale
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local

# Posta: casella portaleacv@arciericastello.it, SMTP 465 smtps su mail.arciericastello.it (deploy.md §0).
# Nella password niente «$»: dentro le virgolette doppie viene letto come variabile.
# Il mittente deve essere la casella stessa, altrimenti le email finiscono nello spam.
# La password va solo nel .env del server, mai qui.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.arciericastello.it
MAIL_PORT=465
MAIL_USERNAME=portaleacv@arciericastello.it
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="portaleacv@arciericastello.it"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Sito della Compagnia: le pagine pubbliche del gestionale ne riprendono
# intestazione, menu e piè di pagina (config/sito.php).
SITO_URL=https://arciericastello.valconi.it
# Definitivo (da attivare quando il sito è online): SITO_URL=https://arciericastello.it
SITO_EMAIL=info@arciericastello.it

# Lettura degli scontrini con OCR.space (v0.39.0). La chiave non va mai
# scritta altrove. OCR_SPACE_CA solo in locale se l'antivirus controlla l'HTTPS.
OCR_SPACE_KEY=
OCR_SPACE_CA=
